---
import '@fontsource/plus-jakarta-sans/latin-600.css';
import '@fontsource/plus-jakarta-sans/latin-700.css';
import '@fontsource/plus-jakarta-sans/latin-800.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '../styles/global.css';
import fontInter4 from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import fontInter6 from '@fontsource/inter/files/inter-latin-600-normal.woff2?url';
import fontPjs8 from '@fontsource/plus-jakarta-sans/files/plus-jakarta-sans-latin-800-normal.woff2?url';
import FluidBackground from '../components/FluidBackground.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  path?: string;
  noindex?: boolean;
  structuredData?: boolean;
}
const { title, description, path = '/', noindex = false, structuredData = false } = Astro.props;
const SITE = 'https://www.talmiro.de';
const canonical = SITE + path;
const ogImage = SITE + '/og-image.png';

const ld = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Talmiro',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web',
    inLanguage: 'de',
    url: SITE + '/',
    description:
      'Talmiro ist der KI-Assistent für selbstständige Headhunter und kleine Personalberatungen: Kandidaten, Mandate, Verträge und Rechnungen per Sprache vorbereiten – nichts geht nach außen ohne Ihr Ja.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'littlewebman',
    url: 'https://www.littlewebman.de',
    brand: { '@type': 'Brand', name: 'Talmiro', url: SITE + '/' },
  },
];
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="preload" href={fontInter4} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fontInter6} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fontPjs8} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#14305E" />
    <!-- Scroll-Reveal aktivieren (ohne defer/async: js-reveal muss vor dem ersten Rendern gesetzt sein) -->
    <script is:inline src="/js/reveal-init.js"></script>

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Talmiro" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Talmiro – Recruiting per Zuruf." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {structuredData && ld.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Zum Inhalt springen</a>
    <FluidBackground strength="subtle" />
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      // Container ([data-reveal], .card) fahren beim Scrollen zeitversetzt ein (wie Littlewebman).
      // Was gleichzeitig sichtbar wird, erscheint nacheinander im Abstand von STAGGER ms.
      const STAGGER = 220;
      (window as any).__reveal = true;
      const items = document.querySelectorAll<HTMLElement>('.card, [data-reveal]');
      const io = new IntersectionObserver(
        (entries) => {
          entries
            .filter((e) => e.isIntersecting)
            .map((e) => e.target as HTMLElement)
            .sort((a, b) => (a.compareDocumentPosition(b) & Node.DOCUMENT_POSITION_FOLLOWING ? -1 : 1))
            .forEach((el, i) => {
              el.style.setProperty('--reveal-delay', `${Math.min(i, 8) * STAGGER}ms`);
              el.classList.add('is-visible');
              io.unobserve(el);
            });
        },
        { threshold: 0.15, rootMargin: '0px 0px -40px 0px' },
      );
      items.forEach((el) => io.observe(el));
    </script>
  </body>
</html>
