---
import logo from '../assets/logo-mark.webp';
// Bildmarke bleibt in 2-facher Auflösung (184x160) und wird auf 46x40 px angezeigt.
---
<header class="kopf">
  <div class="kopf-innen">
    <a href="/" class="marke" aria-label="Talmiro – zur Startseite">
      <img src={logo.src} alt="" width="46" height="40" class="marke-bild" />
      <span class="wortmarke">TALMIRO</span>
    </a>
    <!-- Mobil (bis 640 px): Design-Umschalter und Menü-Button. Beide nur mit JavaScript sichtbar, sonst bleibt die Navigation offen. -->
    <div class="kopf-aktionen">
      <button type="button" class="theme-knopf" aria-label="Dunkles Design einschalten" aria-pressed="false">
        <svg class="ic-mond" aria-hidden="true" focusable="false" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
        <svg class="ic-sonne" aria-hidden="true" focusable="false" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"></circle><line x1="12" y1="2" x2="12" y2="4"></line><line x1="12" y1="20" x2="12" y2="22"></line><line x1="4.9" y1="4.9" x2="6.3" y2="6.3"></line><line x1="17.7" y1="17.7" x2="19.1" y2="19.1"></line><line x1="2" y1="12" x2="4" y2="12"></line><line x1="20" y1="12" x2="22" y2="12"></line><line x1="4.9" y1="19.1" x2="6.3" y2="17.7"></line><line x1="17.7" y1="6.3" x2="19.1" y2="4.9"></line></svg>
      </button>
      <button type="button" class="menue-knopf" id="menue-knopf" aria-expanded="false" aria-controls="hauptnavigation">
        <span class="sr-only" id="menue-text">Menü öffnen</span>
        <svg class="ic-auf" aria-hidden="true" focusable="false" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="4" y1="7" x2="20" y2="7"></line><line x1="4" y1="12" x2="20" y2="12"></line><line x1="4" y1="17" x2="20" y2="17"></line></svg>
        <svg class="ic-zu" aria-hidden="true" focusable="false" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="6" y1="6" x2="18" y2="18"></line><line x1="18" y1="6" x2="6" y2="18"></line></svg>
      </button>
    </div>
    <nav aria-label="Hauptnavigation" class="nav" id="hauptnavigation">
      <a href="/#funktionen">Funktionen</a>
      <a href="/#ablauf">So funktioniert es</a>
      <a href="/#kontrolle">Kontrolle</a>
      <a href="/#faq">FAQ</a>
      <!-- Desktop: Design-Umschalter rechts vor dem Pilot-Button -->
      <button type="button" class="theme-knopf" aria-label="Dunkles Design einschalten" aria-pressed="false">
        <svg class="ic-mond" aria-hidden="true" focusable="false" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
        <svg class="ic-sonne" aria-hidden="true" focusable="false" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"></circle><line x1="12" y1="2" x2="12" y2="4"></line><line x1="12" y1="20" x2="12" y2="22"></line><line x1="4.9" y1="4.9" x2="6.3" y2="6.3"></line><line x1="17.7" y1="17.7" x2="19.1" y2="19.1"></line><line x1="2" y1="12" x2="4" y2="12"></line><line x1="20" y1="12" x2="22" y2="12"></line><line x1="4.9" y1="19.1" x2="6.3" y2="17.7"></line><line x1="17.7" y1="6.3" x2="19.1" y2="4.9"></line></svg>
      </button>
      <a href="/#pilot" class="knopf">Pilotplatz anfragen</a>
    </nav>
  </div>
</header>

<script>
  // Kopfzeile: Unterlinie erst nach dem Scrollen; Höhe als --kopf-h (für scroll-margin-top);
  // Scroll-Spy: Link des Abschnitts in der Bildschirmmitte bekommt aria-current="true".
  const kopf = document.querySelector<HTMLElement>('.kopf');
  if (kopf) {
    const setzeHoehe = () => document.documentElement.style.setProperty('--kopf-h', `${kopf.offsetHeight}px`);
    const setzeScroll = () => kopf.classList.toggle('is-scrolled', window.scrollY > 4);
    setzeHoehe();
    setzeScroll();
    addEventListener('scroll', setzeScroll, { passive: true });
    addEventListener('resize', setzeHoehe);
  }

  // Mobiles Menü (<= 640 px): Panel unter der Kopfzeile. Ohne JavaScript bleibt die Navigation sichtbar.
  const knopf = document.getElementById('menue-knopf') as HTMLButtonElement | null;
  const text = document.getElementById('menue-text');
  const nav = document.getElementById('hauptnavigation');
  if (kopf && knopf && text && nav) {
    (window as any).__menue = true;
    const schmal = matchMedia('(max-width: 640px)');
    const setze = (offen: boolean, fokus = false) => {
      kopf.classList.toggle('is-offen', offen);
      knopf.setAttribute('aria-expanded', String(offen));
      text.textContent = offen ? 'Menü schließen' : 'Menü öffnen';
      if (!offen && fokus) knopf.focus();
      document.documentElement.style.setProperty('--kopf-h', `${kopf.offsetHeight}px`);
    };
    knopf.addEventListener('click', () => setze(knopf.getAttribute('aria-expanded') !== 'true'));
    // Klick auf einen Link schließt das Menü
    nav.addEventListener('click', (e) => { if ((e.target as Element).closest('a')) setze(false); });
    // Escape: schließen, Fokus zurück auf den Button
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && knopf.getAttribute('aria-expanded') === 'true') setze(false, true);
    });
    // Klick außerhalb
    document.addEventListener('click', (e) => {
      if (knopf.getAttribute('aria-expanded') === 'true' && !kopf.contains(e.target as Node)) setze(false);
    });
    // Wechsel auf > 640 px
    schmal.addEventListener('change', () => { if (!schmal.matches) setze(false); });
  }

  // Design-Umschalter (hell/dunkel). Startwert setzt public/js/reveal-init.js vor dem ersten Rendern.
  const wurzel = document.documentElement;
  const themeKnoepfe = document.querySelectorAll<HTMLButtonElement>('.theme-knopf');
  if (themeKnoepfe.length) {
    const zeige = () => {
      const dunkel = wurzel.dataset.theme === 'dark';
      themeKnoepfe.forEach((k) => {
        k.setAttribute('aria-pressed', String(dunkel));
        k.setAttribute('aria-label', dunkel ? 'Helles Design einschalten' : 'Dunkles Design einschalten');
      });
    };
    zeige();
    // reagiert auch auf Wechsel durch die Systemeinstellung (reveal-init.js) oder einen anderen Tab
    new MutationObserver(zeige).observe(wurzel, { attributes: true, attributeFilter: ['data-theme'] });
    let timer = 0;
    themeKnoepfe.forEach((k) =>
      k.addEventListener('click', () => {
        const neu = wurzel.dataset.theme === 'dark' ? 'light' : 'dark';
        wurzel.classList.add('theme-wechsel'); // kurze Farbübergänge nur beim Umschalten
        wurzel.dataset.theme = neu;
        try { localStorage.setItem('talmiro-theme', neu); } catch { /* Speicher gesperrt: Wahl gilt nur für diese Sitzung */ }
        clearTimeout(timer);
        timer = window.setTimeout(() => wurzel.classList.remove('theme-wechsel'), 300);
      }),
    );
  }

  const links = new Map<string, HTMLAnchorElement>();
  document.querySelectorAll<HTMLAnchorElement>('.nav a:not(.knopf)[href^="/#"]').forEach((a) => {
    links.set(a.getAttribute('href')!.slice(2), a);
  });
  const sektionen = [...links.keys()]
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  if (sektionen.length) {
    const sichtbar = new Set<string>();
    const aktualisiere = () => {
      // erster Abschnitt in Dokumentreihenfolge, der die Bildschirmmitte berührt
      const aktiv = sektionen.find((s) => sichtbar.has(s.id))?.id;
      links.forEach((a, id) => (id === aktiv ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
    };
    const spy = new IntersectionObserver(
      (eintraege) => {
        eintraege.forEach((e) => (e.isIntersecting ? sichtbar.add(e.target.id) : sichtbar.delete(e.target.id)));
        aktualisiere();
      },
      { rootMargin: '-45% 0px -54% 0px' },
    );
    sektionen.forEach((s) => spy.observe(s));
  }
</script>
