---
// Formular sendet per POST an /kontakt.php (funktioniert ohne JavaScript).
// Das versteckte Feld "t" setzt public/form-zeit.js (Mindestzeit-Prüfung, optional).
---
<section id="pilot" class="pilot" aria-labelledby="pilot-titel">
  <div class="wrap">
    <div class="pilot-text" data-reveal>
      <h2 id="pilot-titel" class="titel-verlauf">Pilotkunde werden</h2>
      <p class="einleitung">Talmiro entsteht im engen Austausch mit Headhuntern aus der Praxis. Als Pilotkunde gestalten Sie mit.</p>
      <ul>
        <li>Einrichtung in Ihrem Design und Übernahme Ihrer Daten: kostenlos</li>
        <li>3 Monate kostenlos testen, mit kurzem Feedback-Gespräch alle zwei Wochen</li>
        <li>Danach Pilotpreis 79 € im Monat, für 12 Monate garantiert (regulär 129 €)</li>
        <li>Monatlich kündbar</li>
        <li>Direkter Draht zum Entwickler und Einfluss auf neue Funktionen</li>
      </ul>
      <p class="preis-hinweis">Gemäß § 19 UStG wird keine Umsatzsteuer berechnet. Die Claude-App von Anthropic ist nicht enthalten.</p>
    </div>
    <form class="formular" data-reveal action="/kontakt.php" method="post" aria-label="Pilotplatz anfragen" id="pilot-formular">
      <div class="feld">
        <label for="f-name">Name</label>
        <input id="f-name" name="name" type="text" autocomplete="name" required maxlength="100" />
      </div>
      <div class="feld">
        <label for="f-mail">E-Mail</label>
        <input id="f-mail" name="email" type="email" autocomplete="email" required maxlength="254" />
      </div>
      <div class="feld">
        <label for="f-firma">Firma (optional)</label>
        <input id="f-firma" name="firma" type="text" autocomplete="organization" maxlength="150" />
      </div>
      <div class="feld">
        <label for="f-msg">Was soll Talmiro Ihnen abnehmen?</label>
        <textarea id="f-msg" name="nachricht" rows="4" required maxlength="3000"></textarea>
      </div>
      <div class="hp" aria-hidden="true">
        <label for="f-web">Bitte leer lassen</label>
        <input id="f-web" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>
      <input type="hidden" name="t" id="f-zeit" value="" />
      <div class="feld-ds">
        <input id="f-ds" name="datenschutz" type="checkbox" value="1" required />
        <label for="f-ds">Ich habe die <a href="/datenschutz/">Datenschutzhinweise</a> zur Kenntnis genommen.</label>
      </div>
      <button type="submit" class="knopf">Anfrage senden</button>
    </form>
  </div>
  <script src="/form-zeit.js" defer></script>
</section>
