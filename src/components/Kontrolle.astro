---
const regeln = [
  ['Vorschau und Ja', 'Versand, Überschreiben und Löschen nur nach ausdrücklicher Bestätigung.'],
  ['Stopp-Fenster', 'Mails, Profile, Verträge und Rechnungen lassen sich bis zum Versand zurückholen.'],
  ['Keine geschützten Merkmale', 'Alter, Herkunft, Foto und Co. werden weder gespeichert noch bewertet.'],
  ['Nachvollziehbar', 'Jede Aktion wird protokolliert – ohne Inhalte, nur was wann geschah.'],
  ['Zustimmung des Kandidaten', 'Profile gehen nur an Kunden, wenn der Kandidat zugestimmt hat.'],
  ['Datenschutz und Hosting', '[ANGABEN ZU SERVERSTANDORT UND AUFTRAGSVERARBEITUNG – nach rechtlicher Klärung]'],
];
---
<section id="kontrolle" class="kontrolle" aria-labelledby="kontrolle-titel">
  <div class="wrap">
    <div class="kontrolle-kopf" data-reveal>
      <h2 id="kontrolle-titel">Sie behalten die Kontrolle</h2>
      <p class="einleitung">Ein Assistent, der für Sie handelt, muss berechenbar sein. Deshalb gelten in Talmiro feste Regeln, die keine Eingabe aushebeln kann.</p>
    </div>
    <div class="kontrolle-raster" data-reveal>
      {regeln.map(([t, x]) => (
        <div class="regel"><h3>{t}</h3><p>{x}</p></div>
      ))}
    </div>
  </div>
</section>
