---
interface Props { lang?: 'de' | 'en' }
const { lang = 'de' } = Astro.props;
const T = lang === 'en'
  ? { prod: 'A product by', recht: 'Legal', impressum: 'Legal notice', datenschutz: 'Privacy', kontakt: 'Contact' }
  : { prod: 'Ein Produkt von', recht: 'Rechtliches', impressum: 'Impressum', datenschutz: 'Datenschutz', kontakt: 'Kontakt' };
---
<footer class="footer">
  <div class="footer-innen">
    <div class="footer-marke">
      <span class="wortmarke">TALMIRO</span>
      <span>{T.prod} <a href="https://www.littlewebman.de" target="_blank" rel="noopener">littlewebman</a></span>
    </div>
    <nav aria-label={T.recht}>
      <a href="/impressum/">{T.impressum}</a>
      <a href="/datenschutz/">{T.datenschutz}</a>
      <a href="/#pilot">{T.kontakt}</a>
    </nav>
  </div>
</footer>
