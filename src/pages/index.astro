---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Problem from '../components/Problem.astro';
import Ablauf from '../components/Ablauf.astro';
import Funktionen from '../components/Funktionen.astro';
import Agenten from '../components/Agenten.astro';
import Einblicke from '../components/Einblicke.astro';
import Kontrolle from '../components/Kontrolle.astro';
import Pilot from '../components/Pilot.astro';
import Faq from '../components/Faq.astro';
---
<Base
  title="Talmiro – Recruiting per Zuruf"
  description="Talmiro ist der KI-Assistent für selbstständige Headhunter: Kandidaten, Mandate, Verträge und Rechnungen per Sprache vorbereiten. Nichts geht nach außen ohne Ihr Ja."
  path="/"
  structuredData
>
  <Hero />
  <Problem />
  <Ablauf />
  <Funktionen />
  <Agenten />
  <Einblicke />
  <Kontrolle />
  <Pilot />
  <Faq />
</Base>
