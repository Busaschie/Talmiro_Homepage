---
import JobsLayout from '../../layouts/JobsLayout.astro';
import { STELLEN_DEMO } from '../../config';

---
<JobsLayout lang="de" vorlage mainClass="job-page">
  <div class="wrap job-page-inner">
    <a class="job-back" href="/jobs/"><svg aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>Alle Stellen</a>
    {STELLEN_DEMO && <p class="job-demo-hinweis" role="note">Beispielseite – Demonstration der Talmiro-Stellenbörse, keine echten Stellen</p>}
    <article class="job-body" id="job-body" data-job-body>
      <Fragment set:html="{{JOB_BODY}}" />
      <section class="job-section job-contact-section">
        <h2>Ihr Kontakt</h2>
        <div class="job-contact">
          <p><strong>Ihre Ansprechperson</strong><br />Headhunter:in · Ihre Personalberatung</p>
        </div>
      </section>
      <section class="job-section">
        <p class="job-note"><svg aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg><span>Beispieltext: Hier stehen in der echten Stellenbörse die Hinweise Ihrer Personalberatung, zum Beispiel dazu, wann der Name des Unternehmens genannt wird und wie mit Bewerbungen umgegangen wird.</span></p>
      </section>
    </article>
    <a class="job-back job-back-bottom" href="/jobs/"><svg aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>Alle offenen Stellen</a>
  </div>
</JobsLayout>
