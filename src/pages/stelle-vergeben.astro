---
import JobsLayout from '../layouts/JobsLayout.astro';
---
<JobsLayout lang="de" title="Stelle nicht mehr verfügbar – Talmiro" description="Diese Stelle ist nicht mehr verfügbar.">
  <div class="wrap job-wrap job-vergeben">
    <h1 class="titel-verlauf">Diese Stelle ist nicht mehr verfügbar</h1>
    <p class="einleitung">Die Stelle wurde besetzt, die Anzeige ist beendet oder die Adresse stimmt nicht.</p>
    <p class="job-vergeben-links">
      <a class="knopf knopf-gross" href="/jobs/">Alle aktuellen Stellen</a>
      <a class="knopf knopf-gross knopf-rand" href="/">Zur Startseite</a>
    </p>
  </div>
</JobsLayout>
