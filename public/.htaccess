# Talmiro – Apache (febas). Voraussetzung: mod_rewrite, mod_headers, mod_authz_core.

DirectoryIndex index.html index.php
Options -Indexes

# ---- HTTPS und www ---------------------------------------------------------
RewriteEngine On

# HTTP -> HTTPS
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://www.talmiro.de%{REQUEST_URI} [L,R=301]

# ohne www -> www
RewriteCond %{HTTP_HOST} ^talmiro\.de$ [NC]
RewriteRule ^ https://www.talmiro.de%{REQUEST_URI} [L,R=301]

# ---- Fehlerseite -----------------------------------------------------------
ErrorDocument 404 /404.html

# ---- Stellenbörse /jobs/ -----------------------------------------------------
# Die Stellenseiten legt das CRM per SFTP in /jobs/ und /jobs/en/ ab (nicht Teil dieses Uploads). Die Website liefert dort nur
# vergeben.html (DE) und en/vergeben.html (EN): Ziel für entfernte oder unbekannte Stellen (404) und endgültig entfernte (410).
<If "%{REQUEST_URI} =~ m#^/jobs/en/#">
  ErrorDocument 404 /jobs/en/vergeben.html
  ErrorDocument 410 /jobs/en/vergeben.html
</If>
<ElseIf "%{REQUEST_URI} =~ m#^/jobs/#">
  ErrorDocument 404 /jobs/vergeben.html
  ErrorDocument 410 /jobs/vergeben.html
</ElseIf>
# Demo (STELLEN_DEMO = true in src/config.ts): /jobs/ nie indexieren. Zeilen mit #@demo / #@echt wählt scripts/make-vorlagen.mjs beim Build.
#@demo <IfModule mod_headers.c>
#@demo   <If "%{REQUEST_URI} =~ m#^/jobs/#">
#@demo     Header always set X-Robots-Tag "noindex, nofollow"
#@demo   </If>
#@demo </IfModule>
# Listen und Sitemap ändern sich mit jeder Veröffentlichung: nur 5 Minuten cachen
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/jobs/(en/)?(index\.html)?$# || %{REQUEST_URI} == '/jobs/sitemap-jobs.xml'">
    Header set Cache-Control "public, max-age=300"
  </If>
</IfModule>

# ---- Nicht abrufbar: PHP-Konfiguration, Ratenlimit-Dateien, Versteckte -------
<FilesMatch "^(kontakt\.config(\.example)?\.php|.*\.rl|\.htaccess|\.htpasswd)$">
  Require all denied
</FilesMatch>
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
<IfModule mod_rewrite.c>
  RewriteRule ^(talmiro_rl|ratelimit)/ - [F,L]
</IfModule>

# ---- Security-Header ---------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  # Alles lokal (Schriften, Bilder, Skripte); Formular nur an die eigene Domain.
  # Keine Inline-Skripte und keine Inline-Styles: script-src und style-src bleiben bei 'self'.
  # Gilt auch für /jobs/: die Stellenseiten laden CSS, Skripte, Schriften und Bilder nur von dieser Domain (JSON-LD ist ein Datenblock, kein Skript).
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; media-src 'self'; font-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
</IfModule>

# ---- Caching: gehashte Assets lange, HTML kurz -----------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType video/mp4 "access plus 1 month"
  ExpiresByType video/webm "access plus 1 month"
</IfModule>

# MIME-Typen für Video und moderne Bildformate (falls der Server sie nicht kennt)
<IfModule mod_mime.c>
  AddType video/mp4 .mp4 .m4v
  AddType video/webm .webm
  AddType text/vtt .vtt
  AddType image/webp .webp
  AddType image/avif .avif
</IfModule>

# Dateien unter /media/ (Hero-Video, Poster) haben feste Namen und werden später getauscht: nur 1 Tag cachen.
# Die Dateinamen unter /_astro/ enthalten einen Hash und dürfen lange gecacht werden.
<IfModule mod_rewrite.c>
  RewriteRule ^media/ - [E=MEDIA_KURZ:1]
</IfModule>
<IfModule mod_headers.c>
  Header set Cache-Control "public, max-age=86400" env=MEDIA_KURZ
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml
</IfModule>

# Skripte unter /js und form-zeit.js sind nicht gehasht: kurz cachen
<FilesMatch "^(form-zeit|reveal-init)\.js$">
  <IfModule mod_expires.c>
    ExpiresByType application/javascript "access plus 1 day"
    ExpiresByType text/javascript "access plus 1 day"
  </IfModule>
</FilesMatch>
