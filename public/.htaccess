# Talmiro – Apache (febas). Voraussetzung: mod_rewrite, mod_headers, mod_authz_core.

DirectoryIndex index.html index.php
Options -Indexes

# ---- HTTPS und www ---------------------------------------------------------
RewriteEngine On

# HTTP -> HTTPS
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://www.talmiro.de%{REQUEST_URI} [L,R=301]

# ohne www -> www
RewriteCond %{HTTP_HOST} ^talmiro\.de$ [NC]
RewriteRule ^ https://www.talmiro.de%{REQUEST_URI} [L,R=301]

# ---- Fehlerseite -----------------------------------------------------------
ErrorDocument 404 /404.html

# ---- Nicht abrufbar: PHP-Konfiguration, Ratenlimit-Dateien, Versteckte -------
<FilesMatch "^(kontakt\.config(\.example)?\.php|.*\.rl|\.htaccess|\.htpasswd)$">
  Require all denied
</FilesMatch>
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
<IfModule mod_rewrite.c>
  RewriteRule ^(talmiro_rl|ratelimit)/ - [F,L]
</IfModule>

# ---- Security-Header ---------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  # Alles lokal (Schriften, Bilder, Skripte); Formular nur an die eigene Domain.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
</IfModule>

# ---- Caching: gehashte Assets lange, HTML kurz -----------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml
</IfModule>

# Das Formular-Skript ist nicht gehasht: kurz cachen
<Files "form-zeit.js">
  <IfModule mod_expires.c>
    ExpiresDefault "access plus 1 day"
  </IfModule>
</Files>
